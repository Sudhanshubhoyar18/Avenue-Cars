# ==========================================
# AVENUE CARS - ENVIRONMENT CONFIGURATION
# ==========================================

# 1. DATABASE
# For local zero-config SQLite:
DATABASE_URL="file:./dev.db"
# For Supabase / PostgreSQL (Production):
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 2. NEXTAUTH / SECURITY
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="avenue-cars-ultra-secure-nextauth-secret-key-32chars-min"
APP_URL="http://localhost:3000"

# 3. ADMIN ALLOW-LIST (Comma-separated Google email addresses)
# Only accounts matching this list are granted ADMIN role via Google OAuth.
ADMIN_EMAILS="tejas.singh@avenuecars.com,falgunkubde@gmail.com"

# 4. GOOGLE OAUTH 2.0 (From Google Cloud Console)
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"

# 5. TELEGRAM BOT API (From @BotFather)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME="AvenueCarsBot"

# 6. EMAIL SERVICE (Resend API)
RESEND_API_KEY=""
EMAIL_FROM="Avenue Cars <notifications@avenuecars.com>"

